# Generate tokens: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MCP_MAINTAINER_TOKEN=
HOST=127.0.0.1
PORT=8080
PUBLIC_URL=http://localhost:8080
DATABASE_PATH=./data/knowledge.sqlite
# Local Developer usage counters; no request content is stored in these statistics.
USAGE_STATS_ENABLED=true
USAGE_RETENTION_DAYS=90
