{
  "name": "PAD Robin Data Type Reference",
  "version": "3.1.1",
  "date": "2026-10-09",
  "description": "Deterministic fill rules for every PAD Robin parameter type. Each type has a validated example showing the exact syntax PAD accepts. v3.0 adds the three types that Action KB v3.0 (1185 selector variants) uses and v2.0 lacked. v3.1 adds PowerPointInstanceHandle and Int64 for Action KB v3.1 (PAD 2.72).",
  "rules": [
    "String values use $'''value''' format (dollar-triple-quotes)",
    "Boolean values are bare True or False",
    "Integer/Decimal values are bare numbers",
    "Handle/instance variables use bare variable names from previous action outputs",
    "Enum values are pre-filled in action templates - use Module.EnumType.Value format to change",
    "Empty backticks `` mean the param needs a value filled in",
    "Params with values already filled (True, False, numbers, enums) can be left as-is"
  ],
  "total_types": 44,
  "types": [
    {
      "type": "String",
      "category": "value",
      "example": "$'''example'''",
      "description": "Text value wrapped in dollar-triple-quotes",
      "format": "$'''your_value_here'''"
    },
    {
      "type": "Int32",
      "category": "value",
      "example": "1",
      "description": "Integer number, bare value",
      "format": "number"
    },
